# ============================================================
# SatQuery AI - Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ============================================================
# AI / GEMINI
# ============================================================
GEMINI_API_KEY=your_gemini_api_key_here

# ============================================================
# DATABASE
# ============================================================
DATABASE_URL=postgresql+asyncpg://satquery:password@localhost:5432/satquery_db
# For sync alembic migrations:
SYNC_DATABASE_URL=postgresql://satquery:password@localhost:5432/satquery_db

# ============================================================
# REDIS (job queue, caching)
# ============================================================
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ============================================================
# STORAGE
# ============================================================
UPLOAD_DIR=./data/uploads
PROCESSED_DIR=./data/processed
RESULTS_DIR=./data/results
MODEL_CACHE_DIR=./models/checkpoints

# ============================================================
# FILE LIMITS
# ============================================================
MAX_UPLOAD_SIZE=2147483648
MAX_IMAGE_DIMENSION=65536

# ============================================================
# COMPUTE DEVICE
# ============================================================
# Options: auto | cuda | cpu
DEVICE=auto

# ============================================================
# AUTHENTICATION
# ============================================================
SECRET_KEY=change_me_to_a_very_long_random_secret_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ============================================================
# APP CONFIGURATION
# ============================================================
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
DEBUG=true
LOG_LEVEL=INFO

# ============================================================
# HUGGING FACE (model downloads)
# ============================================================
HF_TOKEN=
HF_HOME=./models/checkpoints
